{% extends 'base.html.twig' %}

{% block title %}Finalite index{% endblock %}

{% block body %}
    <h1>Finalite index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for finalite in finalites %}
            <tr>
                <td>{{ finalite.id }}</td>
                <td>{{ finalite.nom }}</td>
                <td>{{ finalite.description }}</td>
                <td>
                    <a href="{{ path('app_finalite_show', {'id': finalite.id}) }}">show</a>
                    <a href="{{ path('app_finalite_edit', {'id': finalite.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_finalite_new') }}">Create new</a>
{% endblock %}
