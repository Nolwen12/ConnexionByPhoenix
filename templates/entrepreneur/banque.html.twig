{% extends 'base.html.twig' %}

{% block title %}Hello EntrepreneurController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Les banques se confiances</h1>
    <table class="table table-striped-columns">
        <thead>
            <tr>
            <th scope="col">Nom</th>
            <th scope="col">Adresse</th>
            <th scope="col">CP</th>
            <th scope="col">ville</th>
            </tr>
        </thead>
        <tbody>
            {% for banques in banque%}
                <tr>
                <th scope="row">{{banques.nom}}</th>
                <td>{{banques.adresse}}</td>
                <td>{{banques.cp}}</td>
                <td>{{banques.ville}}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
