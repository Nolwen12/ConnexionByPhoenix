{% extends 'base.html.twig' %}

{% block title %}Hello EntrepreneurController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Isphers {{entreprise.nom}}</h1>
    <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">Jean</h5>
                <p class="card-text">Bonjour je suis Jean</p>
            </div>
            <p class="card-text">20/02/2026 16:30</p>
        </div>
    {% for messages in message%}
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">{{entreprise.user.username}}</h5>
                <p class="card-text">{{messages.contenue}}</p>
            </div>
            <p class="card-text">{{messages.createdAt}}</p>
        </div>
    {% endfor %}

    
</div>
{% endblock %}
