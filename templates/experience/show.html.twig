{% extends 'base.html.twig' %}

{% block title %}Experience{% endblock %}

{% block body %}
    <h1>Experience</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ experience.id }}</td>
            </tr>
            <tr>
                <th>Nom_poste</th>
                <td>{{ experience.nomPoste }}</td>
            </tr>
            <tr>
                <th>Nom_entreprise</th>
                <td>{{ experience.nomEntreprise }}</td>
            </tr>
            <tr>
                <th>Date_debut</th>
                <td>{{ experience.dateDebut ? experience.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Date_fin</th>
                <td>{{ experience.dateFin ? experience.dateFin|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Adresse</th>
                <td>{{ experience.adresse }}</td>
            </tr>
            <tr>
                <th>Cp</th>
                <td>{{ experience.cp }}</td>
            </tr>
            <tr>
                <th>Ville</th>
                <td>{{ experience.ville }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_experience_index') }}">back to list</a>

    <a href="{{ path('app_experience_edit', {'id': experience.id}) }}">edit</a>

    {{ include('experience/_delete_form.html.twig') }}
{% endblock %}
